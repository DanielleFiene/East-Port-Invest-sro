# BEGIN Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Force www (vervang dit met non-www als je dat liever wilt)
  RewriteCond %{HTTP_HOST} ^eastportinvest\.com [NC]
  RewriteRule ^ https://www.eastportinvest.com%{REQUEST_URI} [L,R=301]
</IfModule>
# END Rewrite Engine

# BEGIN Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>
# END Security Headers

# BEGIN Caching (voor betere snelheid)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
# END Caching

# BEGIN Remove .html from URLs
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>
# END Remove .html

# BEGIN Prevent directory listing
Options -Indexes
# END Prevent directory listing
